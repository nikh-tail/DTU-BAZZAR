# DTU Bazaar Server Environment Variables
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/dtu_bazaar?schema=public"

JWT_SECRET="dtu_bazaar_jwt_super_secret_key_2026_campus_token"
JWT_EXPIRES_IN="7d"

ALLOWED_EMAIL_DOMAINS="dtu.ac.in,student.dtu.ac.in,dtu.edu"
OTP_EXPIRY_MINUTES=10
SIMULATE_EMAIL_OTP=true

STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# Cloudinary Credentials (Get free from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="dtu-bazaar/listings"
